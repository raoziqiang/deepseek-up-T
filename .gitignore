# 依赖
node_modules/
.pnpm-store/

# 生成的快照载荷（元数据模板会保留目录）
state/snapshots/

# 探针家与预检产物：内含 junction 与本机绝对路径，不可跨机复现；
# schema dump 单份近 1MB / 3 万行，可随时用 `precheck --schema` 重新生成。
state/probe-home/
state/probe-*
state/dump-*
state/*.err

# 临时与日志
tmp/
*.log
*.ndjson

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 大体积构建产物
dist/
build/
*.asar
*.asar.tmp

# 暂存构建（构建链的中间产物 + 待落盘的整包，可随时用 vendor/whale/build.mjs 重建）
state/staged/
state/cmp/

# 候选组合层文件（precheck --profile-json 的输入，源自本机真实 profile，不可跨机复现）
state/candidate/
